# Copy to .env (gitignored) or export in your shell. Only the steps of README section 5 need these.

# HuggingFace: only if the dataset / models become gated, or for higher rate limits
HF_TOKEN=

# Kaggle API token of the account that runs the embedding / rerank kernels (scripts/kaggle/launch_*.py read it from
# this file). Several accounts: KAGGLE_API_KEY, KAGGLE_API_KEY_1, ...; the environment variable
# MEDRET_KAGGLE_KEY=KAGGLE_API_KEY_n picks one (the "key" field of configs/kaggle/*.json only records which was used)
KAGGLE_API_KEY=

# FPT AI Marketplace endpoint serving BAAI/bge-reranker-v2-m3 (open weights), used by `medret run` (pool-vi-m1000)
FPT_API_BASE=
FPT_API_KEY=

# Another config file instead of configs/default.yaml (e.g. configs/laptop-lowmem.yaml on a 16 GB machine)
# MEDRET_CONFIG=configs/default.yaml
